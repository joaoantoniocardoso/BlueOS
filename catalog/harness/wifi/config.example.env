# Copy to config.env and edit. Sourced by all scripts in this directory.
#   cp config.example.env config.env
#
# Catalog harness: used by journey_http --mutating-smoke via catalog/src/wifi_rf.rs
# (this machine = host AP for client journeys, host station for hotspot journeys).

# --- Host AP (this machine) ---
HOST_WIFI_IFACE=wlp8s0
# Competing station profiles that must not steal the radio during AP tests:
HOST_STATION_CONNS="Cardoso"

# WPA2-only AP (PMF off so SAE is not advertised)
WPA2_CONN=Hotspot-WPA2
WPA2_SSID=BlueOS-Hotspot
WPA2_PSK=changeme1234

# WPA3-only AP (SAE + explicit RSN/CCMP — required or wpa_supplicant fails "Could not generate WPA IE")
WPA3_CONN=Hotspot
WPA3_SSID=BlueOS-Hotspot-WPA3
WPA3_PSK=changeme1234

AP_CHANNEL=6
AP_GATEWAY=10.42.0.1
AP_PREFIX=24
DHCP_RANGE=10.42.0.10,10.42.0.200

# --- BlueOS target (ethernet management IP) ---
# Always pass on the CLI, e.g. TARGET=192.168.0.124 ./run-e2e.sh
# BlueOS wifi-manager via nginx (same as the UI):
#   http://$TARGET/wifi-manager/v1.0/...
# Override full base if needed:
# BLUEOS_WIFI_BASE=http://192.168.0.124/wifi-manager/v1.0

CONNECT_TIMEOUT_SEC=90
PING_COUNT=3

# L3 checks after a successful WiFi join (run-journey.sh)
# STATIC_TEST_IP must be in AP subnet and outside DHCP_RANGE to avoid clashes
STATIC_TEST_IP=10.42.0.50
XFER_MIN_BYTES=100000
WIFI_IFACE=wlan0

# BlueOS soft-AP (run-hotspot.sh) — host joins as station
HOTSPOT_GATEWAY=192.168.42.1
HOTSPOT_PREFIX=24
HOST_STATION_E2E_CONN=BlueOS-E2E-Station
E2E_HOTSPOT_SSID=BlueOS-E2E-Hotspot
E2E_HOTSPOT_PSK=changeme1234

# Optional overrides:
# BLUEOS_CABLE_BASE=http://192.168.0.124/cable-guy/v1.0
# BLUEOS_WIFI_BASE=http://192.168.0.124/wifi-manager/v1.0

# Journey defaults (override on CLI)
# MODES=open,wpa,wpa2,transition,wpa3
# TARGETS=192.168.0.124,192.168.0.87

# Expect WPA3 join? used by run-e2e.sh only
# yes | no | auto
EXPECT_WPA3=auto

E2E_PSK=changeme1234
OPEN_SSID=BlueOS-E2E-Open
WPA_SSID=BlueOS-E2E-WPA
TRANSITION_SSID=BlueOS-E2E-Transition
