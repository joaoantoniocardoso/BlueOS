# BlueOS images the tests run, any tag from the registry or a local build works
# Usage: cp env.example .env && uv run --env-file .env pytest
E2E_CORE_IMAGE=bluerobotics/blueos-core:master
E2E_BOOTSTRAP_IMAGE=bluerobotics/blueos-bootstrap:master
# Host ports forwarded to the VM, set them to run several VMs at once
# E2E_SIL_SSH_PORT=2222
# E2E_SIL_HTTP_PORT=8080
